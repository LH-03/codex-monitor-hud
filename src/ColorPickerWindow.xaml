<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ColorPickerWindow" Title="颜色 / Color" Width="420" Height="580" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False">
  <Grid Margin="18">
    <Border CornerRadius="24" Background="#FCFFFFFF" BorderBrush="#22000000" BorderThickness="1" Padding="24">
      <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.25" Color="#40000000"/></Border.Effect>
      <StackPanel>
        <Grid x:Name="ColorPickerTitleBar" Height="42"><TextBlock x:Name="ColorPickerTitle" Text="选择颜色 / Choose color" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ColorPickerClose" Content="×" Width="34" Height="34" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" FontSize="20"/></Grid>
        <Canvas x:Name="ColorWheelCanvas" Width="240" Height="240" HorizontalAlignment="Center" Margin="0,8,0,14" ClipToBounds="True">
          <Image x:Name="ColorWheelImage" Width="240" Height="240"/>
          <Ellipse x:Name="ColorWheelMarker" Width="16" Height="16" Stroke="White" StrokeThickness="3" Fill="#22000000"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect></Ellipse>
        </Canvas>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock x:Name="PickerValueLabel" Text="亮度 / Value" VerticalAlignment="Center" Foreground="#FF667085"/><Slider x:Name="PickerValueSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" IsMoveToPointEnabled="True"/><TextBlock x:Name="PickerValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock x:Name="PickerAlphaLabel" Text="透明 / Alpha" VerticalAlignment="Center" Foreground="#FF667085"/><Slider x:Name="PickerAlphaSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" IsMoveToPointEnabled="True"/><TextBlock x:Name="PickerAlphaText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBox x:Name="PickerHexText" FontFamily="Cascadia Code, Consolas" FontSize="14" Padding="10,8"/><Border x:Name="PickerPreview" Grid.Column="1" Margin="10,0,0,0" CornerRadius="10" BorderBrush="#22000000" BorderThickness="1"/></Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="PickerCancelButton" Content="取消（Cancel）" Padding="14,9" Margin="0,0,8,0"/><Button x:Name="PickerApplyButton" Content="应用（Apply）" Padding="16,9" Background="#FF0A84FF" Foreground="White" BorderBrush="Transparent"/></StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
