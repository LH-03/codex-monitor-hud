<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="SettingsWindow"
        Title="Codex Token HUD Settings"
        Width="720"
        Height="790"
        MinWidth="680"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#FF111827" />
    <SolidColorBrush x:Key="Muted" Color="#FF667085" />
    <SolidColorBrush x:Key="Blue" Color="#FF0A84FF" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#FFF2F4F7" />
      <Setter Property="BorderBrush" Value="#12000000" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8ECF2" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#FFF4F6F8" />
      <Setter Property="BorderBrush" Value="#10000000" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="CheckRoot"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="CheckDot"
                        Width="16"
                        Height="16"
                        CornerRadius="8"
                        Background="#FFFFFFFF"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        Margin="0,0,7,0">
                  <TextBlock x:Name="CheckGlyph"
                             Text="✓"
                             Foreground="White"
                             FontSize="10"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                </Border>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckRoot" Property="Background" Value="#FFEAF4FF" />
                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#330A84FF" />
                <Setter TargetName="CheckDot" Property="Background" Value="#FF0A84FF" />
                <Setter TargetName="CheckDot" Property="BorderBrush" Value="#FF0A84FF" />
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#550A84FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckRoot" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,6,12,0" />
      <Setter Property="MinWidth" Value="160" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,6,12,0" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="BorderBrush" Value="#18000000" />
      <Setter Property="Background" Value="#FFF7F8FA" />
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Border x:Name="SettingsShell"
            CornerRadius="24"
            Background="#FCFFFFFF"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="42" ShadowDepth="14" Direction="270" Opacity="0.26" Color="#30000000" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72" />
          <RowDefinition Height="*" />
          <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Margin="26,0,20,0" Background="Transparent">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Codex Token HUD" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SettingsSubtitle" Text="外观与显示设置 · Appearance &amp; display" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
          <Button x:Name="CloseSettingsButton"
                  Content="×"
                  Width="36"
                  Height="36"
                  Padding="0"
                  Margin="0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  FontSize="21"
                  Background="#00FFFFFF"
                  BorderBrush="#00FFFFFF" />
        </Grid>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="26,4,26,22">
            <TextBlock x:Name="PresetsTitle" Text="精选预设  Presets" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="PresetsHint" Text="先选一个好看的起点，再按自己的习惯微调。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,12" />
            <WrapPanel Width="620" HorizontalAlignment="Left">
              <Button x:Name="PresetFrost" Content="Frost  雾白" />
              <Button x:Name="PresetMidnight" Content="Midnight  深空" />
              <Button x:Name="PresetAurora" Content="Aurora  极光" />
              <Button x:Name="PresetGraphite" Content="Graphite  石墨" />
              <Button x:Name="PresetMinimal" Content="Minimal  极简" />
            </WrapPanel>

            <Border Height="1" Background="#10000000" Margin="0,14,0,20" />

            <TextBlock x:Name="LanguageLayoutTitle" Text="文字与布局  Language &amp; layout" FontSize="15" FontWeight="SemiBold" />
            <WrapPanel Margin="0,6,0,0">
              <StackPanel>
                <TextBlock x:Name="DisplayLanguageLabel" Text="显示语言 / Display language" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="LanguageCombo">
                  <ComboBoxItem x:Name="LanguageZhItem" Content="简体中文（Simplified Chinese）" Tag="zh-CN" />
                  <ComboBoxItem x:Name="LanguageEnItem" Content="English（英语）" Tag="en" />
                  <ComboBoxItem x:Name="LanguageSymbolsItem" Content="纯符号（Symbols only）" Tag="symbols" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="BubbleStyleLabel" Text="气泡样式" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="LayoutCombo">
                  <ComboBoxItem x:Name="LayoutChipsItem" Content="分组胶囊  Chips" Tag="chips" />
                  <ComboBoxItem x:Name="LayoutCompactItem" Content="紧凑胶囊  Compact" Tag="compact" />
                  <ComboBoxItem x:Name="LayoutInlineItem" Content="单行极简  Inline" Tag="inline" />
                  <ComboBoxItem x:Name="LayoutOutlineItem" Content="描边胶囊  Outline" Tag="outline" />
                  <ComboBoxItem x:Name="LayoutCardsItem" Content="独立卡片  Cards" Tag="cards" />
                  <ComboBoxItem x:Name="LayoutStackedItem" Content="纵向卡片  Stacked" Tag="stacked" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="NumberFormatLabel" Text="数字格式" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="NumberCombo">
                  <ComboBoxItem x:Name="NumberExactItem" Content="精确数字  123,456" Tag="exact" />
                  <ComboBoxItem x:Name="NumberCompactItem" Content="紧凑数字  123K" Tag="compact" />
                  <ComboBoxItem x:Name="NumberAutoItem" Content="智能切换  Auto" Tag="auto" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="PositionLabel" Text="预设位置" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="PositionCombo">
                  <ComboBoxItem x:Name="PositionTopRightItem" Content="右上" Tag="top-right" />
                  <ComboBoxItem x:Name="PositionTopCenterItem" Content="顶部居中" Tag="top-center" />
                  <ComboBoxItem x:Name="PositionTopLeftItem" Content="左上" Tag="top-left" />
                  <ComboBoxItem x:Name="PositionBottomRightItem" Content="右下" Tag="bottom-right" />
                  <ComboBoxItem x:Name="PositionBottomCenterItem" Content="底部居中" Tag="bottom-center" />
                  <ComboBoxItem x:Name="PositionBottomLeftItem" Content="左下" Tag="bottom-left" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="MonitorScopeLabel" Text="监控范围" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="MonitorScopeCombo">
                  <ComboBoxItem x:Name="MonitorLatestItem" Content="自动跟随最近活动" Tag="latest" />
                  <ComboBoxItem x:Name="MonitorAggregateItem" Content="汇总所有活跃任务" Tag="aggregate" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="ActiveWindowLabel" Text="活跃判定时长" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="ActiveWindowCombo">
                  <ComboBoxItem x:Name="ActiveWindow5Item" Content="5 分钟" Tag="5" />
                  <ComboBoxItem x:Name="ActiveWindow15Item" Content="15 分钟" Tag="15" />
                  <ComboBoxItem x:Name="ActiveWindow30Item" Content="30 分钟" Tag="30" />
                  <ComboBoxItem x:Name="ActiveWindow60Item" Content="60 分钟" Tag="60" />
                </ComboBox>
              </StackPanel>
            </WrapPanel>

            <Border Height="1" Background="#10000000" Margin="0,20,0,20" />

            <TextBlock x:Name="MetricsTitle" Text="显示内容  Metrics" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="MetricsHint" Text="缓存输入属于输入的一部分，不会重复计入合计。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,12" />
            <WrapPanel>
              <CheckBox x:Name="FieldInput" Content="输入总计" Tag="input" />
              <CheckBox x:Name="FieldCached" Content="缓存输入" Tag="cached" />
              <CheckBox x:Name="FieldUncached" Content="未缓存输入" Tag="uncached" />
              <CheckBox x:Name="FieldOutput" Content="输出" Tag="output" />
              <CheckBox x:Name="FieldReasoning" Content="推理输出" Tag="reasoning" />
              <CheckBox x:Name="FieldCallTotal" Content="本次合计" Tag="callTotal" />
              <CheckBox x:Name="FieldTaskTotal" Content="任务累计" Tag="taskTotal" />
              <CheckBox x:Name="FieldContext" Content="上下文占用" Tag="context" />
              <CheckBox x:Name="FieldModel" Content="模型" Tag="model" />
              <CheckBox x:Name="FieldUpdated" Content="更新时间" Tag="updated" />
              <CheckBox x:Name="FieldActiveTasks" Content="活跃任务" Tag="activeTasks" />
              <CheckBox x:Name="FieldWeeklyRemaining" Content="周额度剩余" Tag="weeklyRemaining" />
            </WrapPanel>

            <Border Height="1" Background="#10000000" Margin="0,10,0,20" />

            <TextBlock x:Name="AppearanceTitle" Text="外观微调  Appearance" FontSize="15" FontWeight="SemiBold" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="FontSizeLabel" Grid.Row="0" Text="字号" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <Slider x:Name="FontSizeSlider" Grid.Row="0" Grid.Column="1" Minimum="11" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="FontSizeValue" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock x:Name="RadiusLabel" Grid.Row="1" Text="圆角" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <Slider x:Name="RadiusSlider" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="RadiusValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock x:Name="OpacityLabel" Grid.Row="2" Text="透明度" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Minimum="0.55" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="OpacityValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <WrapPanel Margin="0,12,0,0">
              <CheckBox x:Name="AlwaysOnTopCheck" Content="始终置顶" />
              <CheckBox x:Name="StatusDotCheck" Content="状态指示点" />
              <CheckBox x:Name="AnimateCheck" Content="更新动效" />
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
              <StackPanel>
                <TextBlock x:Name="BackgroundColorLabel" Text="背景 ARGB" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal"><TextBox x:Name="BackgroundText" /><Button x:Name="BackgroundColorButton" Content="●" Width="38" Height="34" Padding="0" Margin="-8,6,12,0" /></StackPanel>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="ForegroundColorLabel" Text="文字 ARGB" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal"><TextBox x:Name="ForegroundText" /><Button x:Name="ForegroundColorButton" Content="●" Width="38" Height="34" Padding="0" Margin="-8,6,12,0" /></StackPanel>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="AccentColorLabel" Text="强调色 ARGB" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal"><TextBox x:Name="AccentText" /><Button x:Name="AccentColorButton" Content="●" Width="38" Height="34" Padding="0" Margin="-8,6,12,0" /></StackPanel>
              </StackPanel>
            </WrapPanel>
            <Expander x:Name="AdvancedStatusExpander" Header="高级状态颜色（Advanced status colors）" Margin="0,16,0,0" FontWeight="SemiBold">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="状态点会根据 Codex 的实时活动自动变色；可直接输入 ARGB，或点击色点打开色环。 / The status dot changes with live Codex activity." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="180"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="活动（Active）" VerticalAlignment="Center"/><TextBox x:Name="StatusActiveText" Grid.Row="0" Grid.Column="1"/><Button x:Name="StatusActiveButton" Grid.Row="0" Grid.Column="2" Content="●" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="1" Text="监听（Listening）" VerticalAlignment="Center"/><TextBox x:Name="StatusListeningText" Grid.Row="1" Grid.Column="1"/><Button x:Name="StatusListeningButton" Grid.Row="1" Grid.Column="2" Content="●" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="2" Text="空闲（Idle）" VerticalAlignment="Center"/><TextBox x:Name="StatusIdleText" Grid.Row="2" Grid.Column="1"/><Button x:Name="StatusIdleButton" Grid.Row="2" Grid.Column="2" Content="●" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="3" Text="暂停（Paused）" VerticalAlignment="Center"/><TextBox x:Name="StatusPausedText" Grid.Row="3" Grid.Column="1"/><Button x:Name="StatusPausedButton" Grid.Row="3" Grid.Column="2" Content="●" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="4" Text="读取错误（Error）" VerticalAlignment="Center"/><TextBox x:Name="StatusErrorText" Grid.Row="4" Grid.Column="1"/><Button x:Name="StatusErrorButton" Grid.Row="4" Grid.Column="2" Content="●" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="5" Text="活动阈值秒数（Active seconds）" VerticalAlignment="Center"/><TextBox x:Name="ActiveSecondsText" Grid.Row="5" Grid.Column="1"/>
                  <TextBlock Grid.Row="6" Text="空闲阈值秒数（Idle seconds）" VerticalAlignment="Center"/><TextBox x:Name="IdleSecondsText" Grid.Row="6" Grid.Column="1"/>
                  <TextBlock Grid.Row="7" Text="错误保持秒数（Error hold）" VerticalAlignment="Center"/><TextBox x:Name="ErrorHoldSecondsText" Grid.Row="7" Grid.Column="1"/>
                </Grid>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="26,10,20,14">
          <Button x:Name="ResetButton" Content="恢复默认" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SaveStatus" Text="设置会实时预览" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,8" />
            <Button x:Name="SaveButton" Content="保存并关闭" Background="#FF0A84FF" Foreground="White" BorderBrush="#00000000" MinWidth="112" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
