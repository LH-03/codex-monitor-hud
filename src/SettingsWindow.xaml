                        <TextBlock x:Name="DotPatternLabel" Text="闪烁方式" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="DotPatternCombo">
                          <ComboBoxItem x:Name="DotPatternSoftItem" Content="柔和单闪" Tag="soft" />
                          <ComboBoxItem x:Name="DotPatternHeartbeatItem" Content="双拍心跳" Tag="heartbeat" />
                          <ComboBoxItem x:Name="DotPatternBeaconItem" Content="信标渐亮" Tag="beacon" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock x:Name="DotBrightnessLabel" Text="提醒亮度" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="DotBrightnessCombo">
                          <ComboBoxItem x:Name="DotBrightnessSubtleItem" Content="克制" Tag="subtle" />
                          <ComboBoxItem x:Name="DotBrightnessBalancedItem" Content="均衡" Tag="balanced" />
                          <ComboBoxItem x:Name="DotBrightnessBrightItem" Content="高亮" Tag="bright" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock x:Name="DotSpeedLabel" Text="提醒速度" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="DotSpeedCombo">
                          <ComboBoxItem x:Name="DotSpeedSlowItem" Content="慢" Tag="slow" />
                          <ComboBoxItem x:Name="DotSpeedNormalItem" Content="正常" Tag="normal" />
                          <ComboBoxItem x:Name="DotSpeedFastItem" Content="快" Tag="fast" />
                        </ComboBox>
                      </StackPanel>
                    </WrapPanel>
                    <CheckBox x:Name="DotBreathingCheck" Content="叠加轻微放大/缩小呼吸" Margin="0,8,0,0" />
                  </StackPanel>
                  </Border>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

        <TabItem x:Name="BehaviorTab" Header="Behavior">
          <ScrollViewer x:Name="BehaviorScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,12,18,20">
              <TextBlock x:Name="BehaviorTitle" Text="行为与提醒  Behavior" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="BehaviorHint" Text="把交互、安静收缩和上下文预警集中在一处；默认保持克制。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap" />

              <Border Width="620" HorizontalAlignment="Left" Background="#080A84FF" BorderBrush="#200A84FF" BorderThickness="1" CornerRadius="13" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock x:Name="TaskNavigationTitle" Text="任务跳转" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="TaskNavigationHint" Text="双击任务列表项或独立气泡，在 Codex 中打开对应任务。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,8" TextWrapping="Wrap" />
                  <CheckBox x:Name="OpenTaskOnDoubleClickCheck" Content="双击打开 Codex 任务详情" />
                </StackPanel>
              </Border>

              <Border Width="620" HorizontalAlignment="Left" Background="#080A84FF" BorderBrush="#200A84FF" BorderThickness="1" CornerRadius="13" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock x:Name="IdleIndicatorTitle" Text="安静指示灯" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="IdleIndicatorHint" Text="长时间没有任务活动时，只保留状态点；悬停或新活动会立即展开。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,8" TextWrapping="Wrap" />
                  <CheckBox x:Name="IdleIndicatorEnabledCheck" Content="启用自动缩回" Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="IdleIndicatorDelayLabel" Text="无活动时长" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="IdleIndicatorDelayCombo" Grid.Column="1">
                      <ComboBoxItem x:Name="IdleIndicator5Item" Content="5 分钟" Tag="5" />
                      <ComboBoxItem x:Name="IdleIndicator15Item" Content="15 分钟" Tag="15" />
                      <ComboBoxItem x:Name="IdleIndicator30Item" Content="30 分钟" Tag="30" />
                      <ComboBoxItem x:Name="IdleIndicator60Item" Content="60 分钟" Tag="60" />
                    </ComboBox>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="IdleIndicatorLayoutLabel" Text="缩回布局" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="IdleIndicatorLayoutCombo" Grid.Column="1">
                      <ComboBoxItem x:Name="IdleIndicatorOverallItem" Content="单个总状态灯" Tag="overall" />
                      <ComboBoxItem x:Name="IdleIndicatorHorizontalItem" Content="横向任务状态灯" Tag="horizontal" />
                      <ComboBoxItem x:Name="IdleIndicatorVerticalItem" Content="纵向任务状态灯" Tag="vertical" />
                    </ComboBox>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="IdleIndicatorTaskStyleLabel" Text="子任务灯样式" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="IdleIndicatorTaskStyleCombo" Grid.Column="1">
                      <ComboBoxItem x:Name="IdleIndicatorTaskDotItem" Content="圆点与编号" Tag="dot" />
                      <ComboBoxItem x:Name="IdleIndicatorTaskBarItem" Content="圆角长条与编号" Tag="bar" />
                    </ComboBox>
                  </Grid>
                  <CheckBox x:Name="IdleIndicatorBubblesCheck" Content="独立气泡也自动缩回" Margin="0,9,0,0" />
                </StackPanel>
              </Border>

              <Border Width="620" HorizontalAlignment="Left" Background="#080A84FF" BorderBrush="#200A84FF" BorderThickness="1" CornerRadius="13" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock x:Name="ContextAlertsTitle" Text="上下文占用提醒" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="ContextAlertsHint" Text="只在向上跨越阈值时提醒；上下文压缩或占用下降后会自动重置。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,8" TextWrapping="Wrap" />
                  <CheckBox x:Name="ContextMetricVisibleCheck" Content="显示上下文占用（提醒必需）" Margin="0,0,0,6" />
                  <CheckBox x:Name="ContextAlertsEnabledCheck" Content="启用三级上下文提醒" Margin="0,0,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ContextThresholdsLabel" Text="提醒阈值" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Grid.RowSpan="3" />
                    <TextBox x:Name="ContextThreshold1Text" Grid.Column="1" Grid.Row="0" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="0" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Blue}" />
                    <TextBlock x:Name="ContextThreshold1Hint" Text="阈值 1 (%)" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,0,0,0" />
                    <TextBox x:Name="ContextThreshold2Text" Grid.Column="1" Grid.Row="1" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="0,7,0,0" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Blue}" />
                    <TextBlock x:Name="ContextThreshold2Hint" Text="阈值 2 (%)" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,7,0,0" />
                    <TextBox x:Name="ContextThreshold3Text" Grid.Column="1" Grid.Row="2" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="0,7,0,0" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Blue}" />
                    <TextBlock x:Name="ContextThreshold3Hint" Text="阈值 3 (%)" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,7,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="MetricsTab" Header="Metrics">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="8,14,8,22">
            <TextBlock x:Name="MetricsTitle" Text="显示内容  Metrics" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="MetricsHint" Text="缓存输入属于输入的一部分，不会重复计入合计。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,12" />
            <WrapPanel>
              <CheckBox x:Name="FieldInput" Content="输入总计" Tag="input" />
              <CheckBox x:Name="FieldCached" Content="缓存输入" Tag="cached" />
              <CheckBox x:Name="FieldCacheHitRate" Content="缓存命中率" Tag="cacheHitRate" Visibility="Collapsed" />
              <CheckBox x:Name="FieldUncached" Content="未缓存输入" Tag="uncached" />
              <CheckBox x:Name="FieldOutput" Content="输出" Tag="output" />
              <CheckBox x:Name="FieldReasoning" Content="推理输出" Tag="reasoning" />
              <CheckBox x:Name="FieldCallTotal" Content="本次合计" Tag="callTotal" />
              <CheckBox x:Name="FieldTaskTotal" Content="任务累计" Tag="taskTotal" Visibility="Collapsed" />
              <CheckBox x:Name="FieldContext" Content="上下文占用" Tag="context" Visibility="Collapsed" />
              <CheckBox x:Name="FieldModel" Content="模型" Tag="model" Visibility="Collapsed" />
              <CheckBox x:Name="FieldUpdated" Content="更新时间" Tag="updated" Visibility="Collapsed" />
              <CheckBox x:Name="FieldActiveTasks" Content="活跃任务" Tag="activeTasks" />
              <CheckBox x:Name="FieldWeeklyRemaining" Content="周额度剩余" Tag="weeklyRemaining" />
              <CheckBox x:Name="FieldFiveHourRemaining" Content="5 小时额度剩余" Tag="fiveHourRemaining" />
              <CheckBox x:Name="FieldEstimatedCost" Content="API 成本估算" Tag="estimatedCost" />
            </WrapPanel>

            <Border Height="1" Background="#10000000" Margin="0,16,0,14" />
            <TextBlock x:Name="PricingSourceTitle" Text="估算价格来源" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="PricingSourceHint" Text="仅按公开 API 文本价格换算，不是订阅账单。留空会优先使用 usage tracker 的价格文件，再回退到内置快照。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,10" />
            <TextBlock x:Name="PricingPathLabel" Text="自定义 pricing.json（可留空）" Foreground="{StaticResource Muted}" Margin="0,0,0,5" />
            <TextBox x:Name="PricingPathText" MinHeight="36" Padding="10,7" />
            <TextBlock x:Name="PricingStatusText" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem x:Name="AppearanceTab" Header="Appearance">
            <ScrollViewer x:Name="AppearanceScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="8,14,8,22">
            <TextBlock x:Name="AppearanceTitle" Text="外观微调  Appearance" FontSize="15" FontWeight="SemiBold" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="FontSizeLabel" Grid.Row="0" Text="字号" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <Slider x:Name="FontSizeSlider" Grid.Row="0" Grid.Column="1" Minimum="11" Maximum="22" TickFrequency="0.1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="FontSizeValue" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock x:Name="RadiusLabel" Grid.Row="1" Text="圆角" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <Slider x:Name="RadiusSlider" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="RadiusValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock x:Name="OpacityLabel" Grid.Row="2" Text="透明度" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="OpacityValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Margin="0,10,0,8">
              <TextBlock x:Name="TransparencyModeLabel" Text="透明方式" FontSize="12" Foreground="{StaticResource Muted}" />
              <ComboBox x:Name="TransparencyModeCombo" HorizontalAlignment="Left">
                <ComboBoxItem x:Name="TransparencyUniformItem" Content="整体透明" Tag="uniform" />
                <ComboBoxItem x:Name="TransparencyLayeredItem" Content="分层清晰" Tag="layered" />
                <ComboBoxItem x:Name="TransparencyFocusItem" Content="智能聚焦" Tag="focus" />
              </ComboBox>
              <TextBlock x:Name="TransparencyHint" Text="分层模式会让背景和次要信息更透明，同时保留数字与状态；智能聚焦会在活动或提醒时自动提高可见度。" MaxWidth="620" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Margin="0,12,0,0">
              <CheckBox x:Name="AlwaysOnTopCheck" Content="始终置顶" />
              <CheckBox x:Name="MousePassthroughCheck" Content="鼠标穿透" />
              <CheckBox x:Name="StatusDotCheck" Content="状态指示点" />
              <CheckBox x:Name="AnimateCheck" Content="更新动效" />
            </WrapPanel>
            <Border x:Name="MousePassthroughNotice" Width="620" HorizontalAlignment="Left" Background="#10FF9F0A" BorderBrush="#30FF9F0A" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,6,0,0">
              <TextBlock x:Name="MousePassthroughHint" MaxWidth="598" Text="开启后 HUD 不再接收鼠标。可用桌面/开始菜单设置快捷方式，或让 Codex 关闭鼠标穿透。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" />
            </Border>
            <WrapPanel Margin="0,4,0,0">
              <StackPanel>
                <TextBlock x:Name="BackgroundColorLabel" Text="背景 ARGB" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal"><TextBox x:Name="BackgroundText" /><Button x:Name="BackgroundColorButton" Style="{StaticResource ColorSwatchButton}" Content="" Width="38" Height="34" Padding="0" Margin="-8,6,12,0" /></StackPanel>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="ForegroundColorLabel" Text="文字 ARGB" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal"><TextBox x:Name="ForegroundText" /><Button x:Name="ForegroundColorButton" Style="{StaticResource ColorSwatchButton}" Content="" Width="38" Height="34" Padding="0" Margin="-8,6,12,0" /></StackPanel>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="AccentColorLabel" Text="强调色 ARGB" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal"><TextBox x:Name="AccentText" /><Button x:Name="AccentColorButton" Style="{StaticResource ColorSwatchButton}" Content="" Width="38" Height="34" Padding="0" Margin="-8,6,12,0" /></StackPanel>
              </StackPanel>
            </WrapPanel>
            <Expander x:Name="AdvancedStatusExpander" Header="高级状态颜色（Advanced status colors）" Width="620" HorizontalAlignment="Left" Margin="0,16,0,0" FontWeight="SemiBold">
              <StackPanel Margin="0,10,0,0">
                <TextBlock MaxWidth="620" HorizontalAlignment="Left" Text="状态点会根据 Codex 的实时活动自动变色；可直接输入 ARGB，或点击色点打开色环。 / The status dot changes with live Codex activity." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                <TextBlock x:Name="StatusPalettesTitle" Text="状态颜色方案" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusPalettesHint" Text="预设只修改五种状态颜色，仍可继续单独自定义。" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,6" />
                <WrapPanel Width="620" HorizontalAlignment="Left" Margin="0,0,0,8">
                  <Button x:Name="StatusPaletteDefault" Content="当前默认" />
                  <Button x:Name="StatusPaletteIntuitive" Content="直觉语义" />
                  <Button x:Name="StatusPaletteColorblind" Content="色觉友好" />
                  <Button x:Name="StatusPaletteCalm" Content="低干扰" />
                  <Button x:Name="StatusPaletteCodexMicro" Content="Codex Micro 展示参考色" />
                </WrapPanel>
                <TextBlock x:Name="StatusPaletteCodexMicroSource" Text="Codex Micro 展示参考色取样自 OpenAI 官方页面；仅作本地视觉参考，未获 OpenAI 认可。不同显示器、色彩管理和主题下的结果不保证与页面或硬件灯光一致。" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="180"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="活动（Active）" VerticalAlignment="Center"/><TextBox x:Name="StatusActiveText" Grid.Row="0" Grid.Column="1"/><Button x:Name="StatusActiveButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="0" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="1" Text="监听（Listening）" VerticalAlignment="Center"/><TextBox x:Name="StatusListeningText" Grid.Row="1" Grid.Column="1"/><Button x:Name="StatusListeningButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="1" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="2" Text="空闲（Idle）" VerticalAlignment="Center"/><TextBox x:Name="StatusIdleText" Grid.Row="2" Grid.Column="1"/><Button x:Name="StatusIdleButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="2" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="3" Text="暂停（Paused）" VerticalAlignment="Center"/><TextBox x:Name="StatusPausedText" Grid.Row="3" Grid.Column="1"/><Button x:Name="StatusPausedButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="3" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="4" Text="读取错误（Error）" VerticalAlignment="Center"/><TextBox x:Name="StatusErrorText" Grid.Row="4" Grid.Column="1"/><Button x:Name="StatusErrorButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="4" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="5" Text="已完成（Completed）" VerticalAlignment="Center"/><TextBox x:Name="StatusCompletedText" Grid.Row="5" Grid.Column="1"/><Button x:Name="StatusCompletedButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="5" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="6" Text="已中止（Aborted）" VerticalAlignment="Center"/><TextBox x:Name="StatusAbortedText" Grid.Row="6" Grid.Column="1"/><Button x:Name="StatusAbortedButton" Style="{StaticResource ColorSwatchButton}" Grid.Row="6" Grid.Column="2" Content="" Padding="0" Margin="0,6,0,4"/>
                  <TextBlock Grid.Row="7" Text="活动阈值秒数（Active seconds）" VerticalAlignment="Center"/><TextBox x:Name="ActiveSecondsText" Grid.Row="7" Grid.Column="1"/>
                  <TextBlock Grid.Row="8" Text="空闲阈值秒数（Idle seconds）" VerticalAlignment="Center"/><TextBox x:Name="IdleSecondsText" Grid.Row="8" Grid.Column="1"/>
                  <TextBlock Grid.Row="9" Text="错误保持秒数（Error hold）" VerticalAlignment="Center"/><TextBox x:Name="ErrorHoldSecondsText" Grid.Row="9" Grid.Column="1"/>
                </Grid>
              </StackPanel>
            </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="26,10,20,14">
          <Button x:Name="ResetButton" Content="恢复默认" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SaveStatus" Text="设置会实时预览" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,8" />
            <Button x:Name="SaveButton" Content="保存并关闭" Background="#FF0A84FF" Foreground="White" BorderBrush="#00000000" MinWidth="112" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
