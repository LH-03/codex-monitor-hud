<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="SettingsWindow"
        Title="Codex Monitor HUD Settings"
        Width="720"
        Height="790"
        MinWidth="680"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#FF111827" />
    <SolidColorBrush x:Key="Muted" Color="#FF667085" />
    <SolidColorBrush x:Key="Blue" Color="#FF0A84FF" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Placement" Value="Mouse" />
      <Setter Property="HorizontalOffset" Value="14" />
      <Setter Property="VerticalOffset" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border MaxWidth="390"
                    Padding="13,10"
                    CornerRadius="11"
                    Background="#F20B1524"
                    BorderBrush="#4224D3FF"
                    BorderThickness="1">
              <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.34" Color="#50000000" />
              </Border.Effect>
              <TextBlock Text="{TemplateBinding Content}"
                         Foreground="#FFF5FAFF"
                         FontSize="12"
                         LineHeight="19"
                         TextWrapping="Wrap" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#FFF2F4F7" />
      <Setter Property="BorderBrush" Value="#12000000" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8ECF2" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ColorSwatchButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="#22000000" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="SwatchChrome" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Border Margin="5" CornerRadius="6" BorderBrush="#48FFFFFF" BorderThickness="1" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwatchChrome" Property="BorderBrush" Value="#B80A84FF" />
                <Setter TargetName="SwatchChrome" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="SwatchChrome" Property="Opacity" Value="0.68" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#FFF4F6F8" />
      <Setter Property="BorderBrush" Value="#10000000" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="360" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="CheckRoot"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="CheckDot"
                        Width="16"
                        Height="16"
                        CornerRadius="8"
                        Background="#FFFFFFFF"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        Margin="0,0,7,0">
                  <TextBlock x:Name="CheckGlyph"
                             Text="✓"
                             Foreground="White"
                             FontSize="10"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                </Border>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckRoot" Property="Background" Value="#FFEAF4FF" />
                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#330A84FF" />
                <Setter TargetName="CheckDot" Property="Background" Value="#FF0A84FF" />
                <Setter TargetName="CheckDot" Property="BorderBrush" Value="#FF0A84FF" />
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#550A84FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckRoot" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#FFF7F9FC" />
      <Setter Property="BorderBrush" Value="#180A84FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,6,12,0" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="360" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ComboToggle"
                            Focusable="False"
                            FocusVisualStyle="{x:Null}"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent"
                            BorderThickness="0">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter />
                  </ControlTemplate>
                </ToggleButton.Template>
                <Border x:Name="ComboChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                  <Grid>
                    <ContentPresenter Margin="0,0,26,0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    <Path HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M0,0 L4,4 L8,0"
                          Stroke="{StaticResource Muted}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                  </Grid>
                </Border>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Placement="Bottom"
                     PopupAnimation="Fade"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Width="{Binding ActualWidth, ElementName=ComboToggle}"
                        Margin="0,5,0,0"
                        Padding="4"
                        Background="#FEFFFFFF"
                        BorderBrush="#260A84FF"
                        BorderThickness="1"
                        CornerRadius="12">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.16" Color="#30000000" />
                  </Border.Effect>
                  <ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboChrome" Property="Background" Value="#FFF1F6FF" />
                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#550A84FF" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="ComboChrome" Property="Background" Value="#FFEAF4FF" />
                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#800A84FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#FFEAF4FF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#1A0A84FF" />
                <Setter Property="Foreground" Value="#FF0A84FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,6,12,0" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="BorderBrush" Value="#18000000" />
      <Setter Property="Background" Value="#FFF7F8FA" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Blue}" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0,0,6,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabPill" Background="#FFF2F4F7" BorderBrush="#10000000" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabPill" Property="Background" Value="#FF0A84FF" />
                <Setter TargetName="TabPill" Property="BorderBrush" Value="#FF0A84FF" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabPill" Property="BorderBrush" Value="#550A84FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Border x:Name="SettingsShell"
            CornerRadius="24"
            Background="#FCFFFFFF"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="42" ShadowDepth="14" Direction="270" Opacity="0.26" Color="#30000000" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72" />
          <RowDefinition Height="*" />
          <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Margin="26,0,20,0" Background="Transparent">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Codex Monitor HUD" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SettingsSubtitle" Text="外观与显示设置 · Appearance &amp; display" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
          <Button x:Name="CloseSettingsButton"
                  Content="×"
                  Width="36"
                  Height="36"
                  Padding="0"
                  Margin="0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  FontSize="21"
                  Background="#00FFFFFF"
                  BorderBrush="#00FFFFFF" />
        </Grid>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="18,0,18,0" Background="Transparent" BorderThickness="0">
          <TabItem x:Name="GeneralTab" Header="General">
            <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="8,14,8,22">
            <TextBlock x:Name="PresetsTitle" Text="精选预设  Presets" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="PresetsHint" Text="先选一个好看的起点，再按自己的习惯微调。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,12" />
            <WrapPanel Width="620" HorizontalAlignment="Left">
              <Button x:Name="PresetFrost" Content="Frost  雾白" />
              <Button x:Name="PresetMidnight" Content="Midnight  深空" />
              <Button x:Name="PresetAurora" Content="Aurora  极光" />
              <Button x:Name="PresetGraphite" Content="Graphite  石墨" />
              <Button x:Name="PresetMinimal" Content="Minimal  极简" />
            </WrapPanel>

            <Border x:Name="ThemeWorkshopDropZone"
                    Width="620"
                    HorizontalAlignment="Left"
                    AllowDrop="True"
                    Background="#080A84FF"
                    BorderBrush="#280A84FF"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12,9"
                    Margin="0,7,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ThemeWorkshopTitle" Text="主题工坊" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="ThemeWorkshopHint" Text="把主题 JSON 拖到这里即可校验并安装；升级不会覆盖。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,12,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ThemeImportButton" Grid.Column="1" Content="导入主题…" Margin="0" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Height="1" Background="#10000000" Margin="0,14,0,20" />

            <TextBlock x:Name="LanguageLayoutTitle" Text="文字与布局  Language &amp; layout" FontSize="15" FontWeight="SemiBold" />
            <WrapPanel Margin="0,6,0,0">
              <StackPanel>
                <TextBlock x:Name="DisplayLanguageLabel" Text="显示语言 / Display language" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="LanguageCombo">
                  <ComboBoxItem x:Name="LanguageZhItem" Content="简体中文（Simplified Chinese）" Tag="zh-CN" />
                  <ComboBoxItem x:Name="LanguageEnItem" Content="English（英语）" Tag="en" />
                  <ComboBoxItem x:Name="LanguageSymbolsItem" Content="纯符号（Symbols only）" Tag="symbols" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="BubbleStyleLabel" Text="气泡样式" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="LayoutCombo">
                  <ComboBoxItem x:Name="LayoutChipsItem" Content="分组胶囊  Chips" Tag="chips" />
                  <ComboBoxItem x:Name="LayoutCompactItem" Content="紧凑胶囊  Compact" Tag="compact" />
                  <ComboBoxItem x:Name="LayoutInlineItem" Content="单行极简  Inline" Tag="inline" />
                  <ComboBoxItem x:Name="LayoutOutlineItem" Content="描边胶囊  Outline" Tag="outline" />
                  <ComboBoxItem x:Name="LayoutCardsItem" Content="独立卡片  Cards" Tag="cards" />
                  <ComboBoxItem x:Name="LayoutStackedItem" Content="纵向卡片  Stacked" Tag="stacked" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="NumberFormatLabel" Text="数字格式" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="NumberCombo">
                  <ComboBoxItem x:Name="NumberExactItem" Content="精确数字  123,456" Tag="exact" />
                  <ComboBoxItem x:Name="NumberCompactItem" Content="紧凑数字  123K" Tag="compact" />
                  <ComboBoxItem x:Name="NumberAutoItem" Content="智能切换  Auto" Tag="auto" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="PositionLabel" Text="预设位置" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="PositionCombo">
                  <ComboBoxItem x:Name="PositionCustomItem" Content="当前位置（已拖动）" Tag="custom" />
                  <ComboBoxItem x:Name="PositionTopRightItem" Content="右上" Tag="top-right" />
                  <ComboBoxItem x:Name="PositionTopCenterItem" Content="顶部居中" Tag="top-center" />
                  <ComboBoxItem x:Name="PositionTopLeftItem" Content="左上" Tag="top-left" />
                  <ComboBoxItem x:Name="PositionBottomRightItem" Content="右下" Tag="bottom-right" />
                  <ComboBoxItem x:Name="PositionBottomCenterItem" Content="底部居中" Tag="bottom-center" />
                  <ComboBoxItem x:Name="PositionBottomLeftItem" Content="左下" Tag="bottom-left" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="MonitorScopeLabel" Text="监控范围" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="MonitorScopeCombo">
                  <ComboBoxItem x:Name="MonitorLatestItem" Content="自动跟随最近活动" Tag="latest" />
                  <ComboBoxItem x:Name="MonitorAggregateItem" Content="汇总所有活跃任务" Tag="aggregate" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="ActiveWindowLabel" Text="活跃判定时长" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="ActiveWindowCombo">
                  <ComboBoxItem x:Name="ActiveWindow5Item" Content="5 分钟" Tag="5" />
                  <ComboBoxItem x:Name="ActiveWindow15Item" Content="15 分钟" Tag="15" />
                  <ComboBoxItem x:Name="ActiveWindow30Item" Content="30 分钟" Tag="30" />
                  <ComboBoxItem x:Name="ActiveWindow60Item" Content="60 分钟" Tag="60" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="TaskRetentionLabel" Text="结束后保留" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="TaskRetentionCombo">
                  <ComboBoxItem x:Name="Retention0Item" Content="立即隐藏" Tag="0" />
                  <ComboBoxItem x:Name="Retention30Item" Content="30 秒" Tag="30" />
                  <ComboBoxItem x:Name="Retention60Item" Content="1 分钟" Tag="60" />
                  <ComboBoxItem x:Name="Retention120Item" Content="2 分钟" Tag="120" />
                  <ComboBoxItem x:Name="Retention300Item" Content="5 分钟" Tag="300" />
                  <ComboBoxItem x:Name="Retention600Item" Content="10 分钟" Tag="600" />
                  <ComboBoxItem x:Name="Retention1800Item" Content="30 分钟" Tag="1800" />
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="TerminalExitModeLabel" Text="完成退场提醒" FontSize="12" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="TerminalExitModeCombo">
                  <ComboBoxItem x:Name="TerminalExitFadeItem" Content="自然淡出" Tag="fade" />
                  <ComboBoxItem x:Name="TerminalExitGentleItem" Content="轻柔提醒（推荐）" Tag="gentle" />
                  <ComboBoxItem x:Name="TerminalExitFocusItem" Content="聚焦退场" Tag="focus" />
                  <ComboBoxItem x:Name="TerminalExitBeaconItem" Content="强提醒退场" Tag="beacon" />
                </ComboBox>
                <TextBlock x:Name="TerminalExitHint" Text="保留时间结束后，只让对应列表行或独立气泡完成这段有界退场动画。" MaxWidth="270" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
              </StackPanel>
            </WrapPanel>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem x:Name="SourcesTab" Header="Sources">
            <ScrollViewer x:Name="SourcesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="8,14,8,22">
                <TextBlock x:Name="SessionSourcesTitle" Text="监控来源" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="SessionSourcesHint"
                           Text="任务行只显示简洁来源图标；把鼠标放到图标上可查看全称。下方图标说明也可以分别控制三类来源。"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}"
                           Margin="0,4,0,14" />
                <Border Width="620" HorizontalAlignment="Left" Background="#0E0A84FF" BorderBrush="#280A84FF" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                  <StackPanel>
                    <CheckBox x:Name="SourceDesktopCheck" Margin="0,0,0,10">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="9" Background="#120A84FF" BorderBrush="#300A84FF" BorderThickness="1" Margin="2,0,10,0">
                          <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M1.4,2.1 L12.6,2.1 Q13,2.1 13,2.5 L13,11.5 Q13,11.9 12.6,11.9 L1.4,11.9 Q1,11.9 1,11.5 L1,2.5 Q1,2.1 1.4,2.1 Z M1.4,4.8 L12.6,4.8 M3,3.45 L3.08,3.45 M4.75,3.45 L4.83,3.45" Stroke="#FF0A84FF" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Viewbox>
                        </Border>
                        <TextBlock x:Name="SourceDesktopOptionText" Text="Codex 桌面端（OpenAI）" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="SourceVsCodeCheck" Margin="0,0,0,10">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="9" Background="#12007ACC" BorderBrush="#30007ACC" BorderThickness="1" Margin="2,0,10,0">
                          <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
