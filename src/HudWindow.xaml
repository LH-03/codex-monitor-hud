<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="HudWindow"
        Title="Codex Token HUD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <Grid Margin="18">
    <Border x:Name="HudShell"
            CornerRadius="22"
            Padding="16,11"
            BorderThickness="1"
            SnapsToDevicePixels="True">
      <Border.Effect>
        <DropShadowEffect x:Name="HudShadow"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.22"
                          Color="#26000000" />
      </Border.Effect>
      <DockPanel LastChildFill="True">
        <Ellipse x:Name="StatusDot"
                 DockPanel.Dock="Left"
                 Width="8"
                 Height="8"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center" />
        <WrapPanel x:Name="MetricsPanel"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"
                   MaxWidth="1480" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
