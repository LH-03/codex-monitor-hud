<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="HudWindow"
        Title="Codex Monitor HUD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="HudIconButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#0A0A84FF" />
      <Setter Property="BorderBrush" Value="#220A84FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="IconChrome"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#180A84FF" />
                <Setter TargetName="IconChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudListToggleButton" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Background" Value="#100A84FF" />
      <Setter Property="BorderBrush" Value="#260A84FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ToggleChrome"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="#1A0A84FF" />
                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.84" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Border x:Name="HudShell"
            CornerRadius="22"
            Padding="16,11"
            BorderThickness="1"
            SnapsToDevicePixels="True">
      <Grid>
      <StackPanel x:Name="HudContentPanel">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot"
                   Grid.Column="0"
                   Width="8"
                   Height="8"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
          <Button x:Name="TaskListToggleButton"
                  Grid.Column="2"
                  Visibility="Collapsed"
                  Margin="8,0,0,0"
                  Style="{StaticResource HudListToggleButton}"
                  FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                  FontSize="12"
                  Cursor="Hand" />
          <WrapPanel x:Name="MetricsPanel"
                     Grid.Column="1"
                     Orientation="Horizontal"
                     VerticalAlignment="Center"
                     MaxWidth="1480" />
        </Grid>
        <Border x:Name="TaskListDivider" Height="1" Background="#16000000" Margin="0,7,0,4" Visibility="Collapsed" />
        <ScrollViewer x:Name="TaskListScroller" MinWidth="900" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="TaskListPanel" />
        </ScrollViewer>
      </StackPanel>
      <StackPanel x:Name="QuietIndicatorPanel"
                  Visibility="Collapsed"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Grid x:Name="QuietOverallHost" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse x:Name="QuietOverallRing" Width="17" Height="17" StrokeThickness="1.5" Opacity="0.48" />
          <Ellipse x:Name="QuietOverallDot" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border x:Name="QuietIndicatorSeparator" Width="1" Height="18" Margin="10,0,9,0" VerticalAlignment="Center" Visibility="Collapsed" />
        <StackPanel x:Name="QuietTaskIndicators" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
