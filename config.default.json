  "cornerRadius": 22,
  "opacity": 0.97,
  "transparencyMode": "uniform",
  "scale": 1.0,
  "alwaysOnTop": true,
  "mousePassthrough": false,
  "showStatusDot": true,
  "animateUpdates": true,
  "themeStyle": {
    "surface": "solid",
    "gradientStart": "#EAF7F8FA",
    "gradientEnd": "#EAF7F8FA",
    "gradientAngle": 135,
    "backgroundImage": "",
    "imageOpacity": 0.28,
    "imageStretch": "uniformToFill",
    "shadow": "soft",
    "borderWidth": 1.0,
    "statusDotSize": 8.0,
    "fontFamily": "Segoe UI Variable Text, Microsoft YaHei UI"
