  "statusPalette": "default",
  "statusColors": {
    "active": "#FF34C759",
    "listening": "#FF0A84FF",
    "idle": "#FFFF9F0A",
    "paused": "#FF8E8E93",
    "error": "#FFFF453A",
    "completed": "#FF32D74B",
