    "autoSplitNewTasks": true,
    "numberCooldownSeconds": 120,
    "listFields": {
      "model": true,
      "callTotal": true,
      "taskTotal": false,
      "estimatedCost": false,
      "updated": false
    },
    "bubbleFields": {
      "model": true,
      "callTotal": true,
      "taskTotal": true,
      "estimatedCost": false,
      "updated": true
    }
  },
  "attention": {
    "summaryMode": "halo",
    "listMode": "flow",
    "taskBubbleMode": "flow",
    "dotEnabled": true,
    "dotPattern": "heartbeat",
    "dotBrightness": "balanced",
    "dotSpeed": "normal",
    "dotBreathing": true,
    "durationSeconds": 6,
    "completionGraceSeconds": 8,
