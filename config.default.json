    "path": ""
  },
  "fields": {
    "input": false,
    "cached": true,
    "uncached": true,
    "output": true,
    "reasoning": false,
    "callTotal": true,
    "taskTotal": true,
    "context": false,
    "model": false,
    "updated": false,
    "activeTasks": true,
