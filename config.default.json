{
  "preset": "frost",
  "language": "zh-CN",
  "layout": "chips",
  "numberFormat": "exact",
  "monitorScope": "aggregate",
  "activeWindowMinutes": 30,
  "multiTask": {
    "displayMode": "summary",
    "listStyle": "rows",
    "listDensity": "compact",
    "nameMode": "hover",
