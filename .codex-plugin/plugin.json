    "local-first",
    "multi-task",
    "pro-workflow"
  ],
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "interface": {
    "displayName": "Codex Monitor HUD",
    "shortDescription": "Local live monitoring for concurrent Codex tasks.",
    "longDescription": "A local-first real-time HUD for high-concurrency Codex workflows. Keep one compact summary, expand a stable numbered task list, split selected tasks into independent bubbles, or opt in to targeted CODEX-labeled mid-task notices while Codex keeps working in the background.",
    "developerName": "Codex Monitor HUD Contributors",
    "category": "Productivity",
    "capabilities": [
      "Interactive"
    ],
    "defaultPrompt": [
      "Open Codex Monitor HUD settings",
      "Explain and configure proactive Codex notices",
      "Explain the Monitor HUD accounting",
      "Repair or restart Codex Monitor HUD"
