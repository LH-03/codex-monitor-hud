      "./assets/color-picker.png",
      "./assets/hud-cards.png",
      "./assets/settings-en.png",
      "./assets/settings-appearance.png",
      "./assets/settings-appearance-en.png",
      "./assets/settings-multitask-en.png",
      "./assets/settings-reminders.png",
